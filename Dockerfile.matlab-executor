# Dockerfile for MATLAB/Octave Executor Service
FROM gnuoctave/octave:8.4.0

WORKDIR /app

# Install Python and gRPC
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Octave packages
RUN octave --eval "pkg install -forge io statistics"

# Install Python gRPC
RUN pip3 install --no-cache-dir grpcio grpcio-tools

# Copy proto files and generate Python code
COPY protos/ ./protos/
RUN python3 -m grpc_tools.protoc \
    -I./protos \
    --python_out=. \
    --grpc_python_out=. \
    ./protos/code_executor.proto

# Copy executor service
COPY grpc_services/matlab_executor.py ./grpc_services/

# Expose gRPC port
EXPOSE 50053

ENV PYTHONUNBUFFERED=1
ENV MAX_WORKERS=10
ENV MEMORY_LIMIT_MB=512

# Run the service
CMD ["python3", "-m", "grpc_services.matlab_executor"]
# Database Migration - Add language field to programming_question table

"""
Migration script to add multi-language support to ProgrammingQuestion model
Run this after updating the model
"""

from app import create_app, db
from sqlalchemy import text

def upgrade():
    """Add language column to programming_question table"""
    app = create_app()
    with app.app_context():
        # Add language column with default value 'python'
        db.engine.execute(text("""
            ALTER TABLE programming_question
            ADD COLUMN IF NOT EXISTS language VARCHAR(20) NOT NULL DEFAULT 'python'
        """))

        print("✅ Migration completed: Added 'language' column to programming_question table")

def downgrade():
    """Remove language column from programming_question table"""
    app = create_app()
    with app.app_context():
        db.engine.execute(text("""
            ALTER TABLE programming_question
            DROP COLUMN IF EXISTS language
        """))

        print("✅ Rollback completed: Removed 'language' column from programming_question table")

if __name__ == '__main__':
    upgrade()

